// Nuklear 4.13.4 bindings (https://github.com/Immediate-Mode-UI/Nuklear @ 709bd63; public domain or
// MIT -- see LICENSE). A single-header ANSI C immediate-mode GUI, compiled in with the
// program: no library to build. Configured with fixed-width types and vertex buffer
// output; without font baking (supply an nk_user_font over your own font) or a default
// allocator (give nk_init_fixed / nk_buffer_init_fixed memory). The caller feeds it
// input and draws the vertex lists nk_convert produces.
//
// A subset: windows, layout rows, labels, buttons, sliders, properties, text fields,
// trees and tooltips. The C header is authoritative for layout.
// Without font baking Nuklear doesn't need its embedded copy of stb_rect_pack, whose
// declarations would make stb_truetype (vendor/stb) expect the real thing: skipped.
@raw("""
#define NK_INCLUDE_FIXED_TYPES
#define NK_INCLUDE_VERTEX_BUFFER_OUTPUT
#define NK_IMPLEMENTATION
#define STB_INCLUDE_STB_RECT_PACK_H
""");
@include("nuklear.h");
@raw("""
#undef STB_INCLUDE_STB_RECT_PACK_H
""");

@compiler_option(
    .options = "-I{relativePath}"
);

//--------------------------------------------------------------------------------------------
// Types
//--------------------------------------------------------------------------------------------

@foreign public typedef usize as nk_size;
@foreign public typedef u32 as nk_flags;
@foreign public typedef i32 as nk_bool;
@foreign public typedef u32 as nk_rune;

@foreign("nk_handle") public union nk_handle {
    ptr: *void
    id: i32
}

@foreign("struct nk_vec2") public struct nk_vec2 {
    x: f32
    y: f32
}

@foreign("struct nk_rect") public struct nk_rect {
    x: f32
    y: f32
    w: f32
    h: f32
}

@foreign("struct nk_color") public struct nk_color {
    r: u8
    g: u8
    b: u8
    a: u8
}

// opaque here, but sized by the C header: embed them by value
@foreign("struct nk_context") public struct nk_context {}
@foreign("struct nk_buffer") public struct nk_buffer {}
@foreign("struct nk_text_edit") public struct nk_text_edit {}

//--------------------------------------------------------------------------------------------
// Fonts: the caller's, through callbacks
//--------------------------------------------------------------------------------------------

@foreign("struct nk_user_font_glyph") public struct nk_user_font_glyph {
    // texture coordinates (top left, bottom right), offset from the top left of the
    // line, size, and the advance to the next glyph
    uv: [2]nk_vec2
    offset: nk_vec2
    width: f32
    height: f32
    xadvance: f32
}

@foreign public typedef func(nk_handle, f32, *const char, i32) : f32 as nk_text_width_f;
@foreign public typedef func(nk_handle, f32, *nk_user_font_glyph, nk_rune, nk_rune) : void as nk_query_font_glyph_f;

@foreign("struct nk_user_font") public struct nk_user_font {
    userdata: nk_handle
    height: f32
    width: nk_text_width_f
    query: nk_query_font_glyph_f
    texture: nk_handle
}

//--------------------------------------------------------------------------------------------
// Drawing: vertex lists from nk_convert, then a draw command per batch
//--------------------------------------------------------------------------------------------

@foreign("struct nk_draw_null_texture") public struct nk_draw_null_texture {
    texture: nk_handle
    uv: nk_vec2
}

@foreign("struct nk_draw_vertex_layout_element") public struct nk_draw_vertex_layout_element {
    attribute: i32
    format: i32
    offset: nk_size
}

@foreign("struct nk_convert_config") public struct nk_convert_config {
    global_alpha: f32
    line_AA: i32
    shape_AA: i32
    circle_segment_count: u32
    arc_segment_count: u32
    curve_segment_count: u32
    tex_null: nk_draw_null_texture
    vertex_layout: *const nk_draw_vertex_layout_element
    vertex_size: nk_size
    vertex_alignment: nk_size
}

@foreign("struct nk_draw_command") public struct nk_draw_command {
    elem_count: u32
    clip_rect: nk_rect
    texture: nk_handle
}

@foreign public const NK_VERTEX_POSITION: i32;
@foreign public const NK_VERTEX_COLOR: i32;
@foreign public const NK_VERTEX_TEXCOORD: i32;
@foreign public const NK_VERTEX_ATTRIBUTE_COUNT: i32;
@foreign public const NK_FORMAT_FLOAT: i32;
@foreign public const NK_FORMAT_R8G8B8A8: i32;
@foreign public const NK_FORMAT_COUNT: i32;

@foreign public const NK_ANTI_ALIASING_OFF: i32;
@foreign public const NK_ANTI_ALIASING_ON: i32;
@foreign public const NK_CONVERT_SUCCESS: nk_flags;

//--------------------------------------------------------------------------------------------
// Flags and enums
//--------------------------------------------------------------------------------------------

@foreign public const nk_false: nk_bool;
@foreign public const nk_true: nk_bool;

@foreign public const NK_WINDOW_BORDER: nk_flags;
@foreign public const NK_WINDOW_MOVABLE: nk_flags;
@foreign public const NK_WINDOW_SCALABLE: nk_flags;
@foreign public const NK_WINDOW_CLOSABLE: nk_flags;
@foreign public const NK_WINDOW_MINIMIZABLE: nk_flags;
@foreign public const NK_WINDOW_NO_SCROLLBAR: nk_flags;
@foreign public const NK_WINDOW_TITLE: nk_flags;
@foreign public const NK_WINDOW_SCROLL_AUTO_HIDE: nk_flags;
@foreign public const NK_WINDOW_NO_INPUT: nk_flags;

@foreign public const NK_TEXT_LEFT: nk_flags;
@foreign public const NK_TEXT_CENTERED: nk_flags;
@foreign public const NK_TEXT_RIGHT: nk_flags;

@foreign public const NK_DYNAMIC: i32;
@foreign public const NK_STATIC: i32;

@foreign public const NK_TREE_NODE: i32;
@foreign public const NK_TREE_TAB: i32;
@foreign public const NK_MINIMIZED: u32;
@foreign public const NK_MAXIMIZED: u32;

@foreign public const NK_EDIT_FIELD: nk_flags;
@foreign public const NK_EDIT_BOX: nk_flags;
@foreign public const NK_EDIT_SIMPLE: nk_flags;
@foreign public const NK_EDIT_ACTIVE: nk_flags;
@foreign public const NK_EDIT_COMMITED: nk_flags;

@foreign public const NK_BUTTON_LEFT: i32;
@foreign public const NK_BUTTON_MIDDLE: i32;
@foreign public const NK_BUTTON_RIGHT: i32;

@foreign public const NK_KEY_SHIFT: i32;
@foreign public const NK_KEY_CTRL: i32;
@foreign public const NK_KEY_DEL: i32;
@foreign public const NK_KEY_ENTER: i32;
@foreign public const NK_KEY_TAB: i32;
@foreign public const NK_KEY_BACKSPACE: i32;
@foreign public const NK_KEY_UP: i32;
@foreign public const NK_KEY_DOWN: i32;
@foreign public const NK_KEY_LEFT: i32;
@foreign public const NK_KEY_RIGHT: i32;
@foreign public const NK_KEY_TEXT_LINE_START: i32;
@foreign public const NK_KEY_TEXT_LINE_END: i32;
@foreign public const NK_KEY_TEXT_SELECT_ALL: i32;
@foreign public const NK_KEY_TEXT_WORD_LEFT: i32;
@foreign public const NK_KEY_TEXT_WORD_RIGHT: i32;
@foreign public const NK_KEY_SCROLL_START: i32;
@foreign public const NK_KEY_SCROLL_END: i32;

//--------------------------------------------------------------------------------------------
// Context, memory and frames
//--------------------------------------------------------------------------------------------

@foreign public func nk_init_fixed(ctx: *nk_context, memory: *void, size: nk_size, font: *const nk_user_font) : nk_bool;
@foreign public func nk_free(ctx: *nk_context);
@foreign public func nk_clear(ctx: *nk_context);
@foreign public func nk_style_set_font(ctx: *nk_context, font: *const nk_user_font);
@foreign public func nk_style_default(ctx: *nk_context);

@foreign public func nk_buffer_init_fixed(buffer: *nk_buffer, memory: *void, size: nk_size);
@foreign public func nk_buffer_clear(buffer: *nk_buffer);
@foreign public func nk_buffer_total(buffer: *const nk_buffer) : nk_size;

@foreign public func nk_convert(ctx: *nk_context, cmds: *nk_buffer, vertices: *nk_buffer, elements: *nk_buffer,
                                config: *const nk_convert_config) : nk_flags;
@foreign public func nk__draw_begin(ctx: *const nk_context, buffer: *const nk_buffer) : *const nk_draw_command;
@foreign public func nk__draw_next(cmd: *const nk_draw_command, buffer: *const nk_buffer,
                                   ctx: *const nk_context) : *const nk_draw_command;

@foreign public func nk_handle_id(id: i32) : nk_handle;
@foreign public func nk_handle_ptr(ptr: *void) : nk_handle;
@foreign public func nk_rgba(r: i32, g: i32, b: i32, a: i32) : nk_color;

//--------------------------------------------------------------------------------------------
// Input: between nk_input_begin and nk_input_end, once a frame
//--------------------------------------------------------------------------------------------

@foreign public func nk_input_begin(ctx: *nk_context);
@foreign public func nk_input_motion(ctx: *nk_context, x: i32, y: i32);
@foreign public func nk_input_key(ctx: *nk_context, key: i32, down: nk_bool);
@foreign public func nk_input_button(ctx: *nk_context, button: i32, x: i32, y: i32, down: nk_bool);
@foreign public func nk_input_scroll(ctx: *nk_context, val: nk_vec2);
@foreign public func nk_input_char(ctx: *nk_context, c: char);
@foreign public func nk_input_unicode(ctx: *nk_context, rune: nk_rune);
@foreign public func nk_input_end(ctx: *nk_context);

//--------------------------------------------------------------------------------------------
// Windows and layout
//--------------------------------------------------------------------------------------------

@foreign public func nk_begin(ctx: *nk_context, title: *const char, bounds: nk_rect, flags: nk_flags) : nk_bool;
@foreign public func nk_end(ctx: *nk_context);
@foreign public func nk_window_is_closed(ctx: *const nk_context, name: *const char) : nk_bool;
@foreign public func nk_window_is_any_hovered(ctx: *const nk_context) : nk_bool;
@foreign public func nk_window_set_focus(ctx: *nk_context, name: *const char);
@foreign public func nk_window_get_bounds(ctx: *const nk_context) : nk_rect;
@foreign public func nk_item_is_any_active(ctx: *const nk_context) : nk_bool;

@foreign public func nk_layout_row_dynamic(ctx: *nk_context, height: f32, cols: i32);
@foreign public func nk_layout_row_begin(ctx: *nk_context, fmt: i32, row_height: f32, cols: i32);
@foreign public func nk_layout_row_push(ctx: *nk_context, value: f32);
@foreign public func nk_layout_row_end(ctx: *nk_context);
@foreign public func nk_layout_row(ctx: *nk_context, fmt: i32, height: f32, cols: i32, ratio: *const f32);
@foreign public func nk_spacing(ctx: *nk_context, cols: i32);

//--------------------------------------------------------------------------------------------
// Widgets
//--------------------------------------------------------------------------------------------

@foreign public func nk_label(ctx: *nk_context, text: *const char, align: nk_flags);
@foreign public func nk_button_label(ctx: *nk_context, title: *const char) : nk_bool;
@foreign public func nk_slider_float(ctx: *nk_context, min: f32, val: *f32, max: f32, step: f32) : nk_bool;
@foreign public func nk_property_float(ctx: *nk_context, name: *const char, min: f32, val: *f32, max: f32,
                                       step: f32, inc_per_pixel: f32) : nk_bool;
@foreign public func nk_propertyf(ctx: *nk_context, name: *const char, min: f32, val: f32, max: f32,
                                  step: f32, inc_per_pixel: f32) : f32;

@foreign public typedef func(*const nk_text_edit, nk_rune) : nk_bool as nk_plugin_filter;
@foreign public func nk_filter_default(edit: *const nk_text_edit, unicode: nk_rune) : nk_bool;
@foreign public func nk_edit_string_zero_terminated(ctx: *nk_context, flags: nk_flags, buffer: *char, max: i32,
                                                    filter: nk_plugin_filter) : nk_flags;

@foreign public func nk_widget_is_hovered(ctx: *const nk_context) : nk_bool;
@foreign public func nk_widget_bounds(ctx: *const nk_context) : nk_rect;
@foreign public func nk_tooltip(ctx: *nk_context, text: *const char);

// state: the section's NK_MINIMIZED / NK_MAXIMIZED, kept by the caller
@foreign public func nk_tree_state_push(ctx: *nk_context, type: i32, title: *const char, state: *u32) : nk_bool;
@foreign public func nk_tree_state_pop(ctx: *nk_context);
