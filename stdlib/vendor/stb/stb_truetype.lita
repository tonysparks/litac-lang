// stb_truetype v1.26 bindings (https://github.com/nothings/stb, public domain / MIT).
// Covers font info/metrics, the packing (atlas) API and single-glyph rasterization.
@raw("""
#define STB_TRUETYPE_IMPLEMENTATION
""");
@include("stb_truetype.h");

@compiler_option(
    .options = "-I{relativePath}"
);

@foreign public struct stbtt_fontinfo {}
@foreign public struct stbtt_pack_context {}

@foreign public struct stbtt_packedchar {
    x0: u16
    y0: u16
    x1: u16
    y1: u16
    xoff: f32
    yoff: f32
    xadvance: f32
    xoff2: f32
    yoff2: f32
}

@foreign public struct stbtt_aligned_quad {
    x0: f32
    y0: f32
    s0: f32
    t0: f32
    x1: f32
    y1: f32
    s1: f32
    t1: f32
}

@foreign public struct stbtt_pack_range {
    font_size: f32
    first_unicode_codepoint_in_range: i32
    array_of_unicode_codepoints: *i32
    num_chars: i32
    chardata_for_range: *stbtt_packedchar
    h_oversample: u8
    v_oversample: u8
}

//--------------------------------------------------------------------------------------------
// Font info / metrics
//--------------------------------------------------------------------------------------------

@foreign public func stbtt_GetNumberOfFonts(data: *const u8) : i32;
@foreign public func stbtt_GetFontOffsetForIndex(data: *const u8, index: i32) : i32;

// data must outlive info; stb_truetype does not copy it.
@foreign public func stbtt_InitFont(info: *stbtt_fontinfo, data: *const u8, offset: i32) : i32;
@foreign public func stbtt_FindGlyphIndex(info: *const stbtt_fontinfo, codepoint: i32) : i32;

@foreign public func stbtt_ScaleForPixelHeight(info: *const stbtt_fontinfo, pixels: f32) : f32;
@foreign public func stbtt_ScaleForMappingEmToPixels(info: *const stbtt_fontinfo, pixels: f32) : f32;
@foreign public func stbtt_GetFontVMetrics(info: *const stbtt_fontinfo, ascent: *i32, descent: *i32, lineGap: *i32);
@foreign public func stbtt_GetFontBoundingBox(info: *const stbtt_fontinfo, x0: *i32, y0: *i32, x1: *i32, y1: *i32);
@foreign public func stbtt_GetCodepointHMetrics(info: *const stbtt_fontinfo, codepoint: i32, advanceWidth: *i32, leftSideBearing: *i32);
@foreign public func stbtt_GetCodepointKernAdvance(info: *const stbtt_fontinfo, ch1: i32, ch2: i32) : i32;
@foreign public func stbtt_GetCodepointBox(info: *const stbtt_fontinfo, codepoint: i32, x0: *i32, y0: *i32, x1: *i32, y1: *i32) : i32;

// Scaled ascent/descent/lineGap straight from the font data, without an stbtt_fontinfo.
@foreign public func stbtt_GetScaledFontVMetrics(fontdata: *const u8, index: i32, size: f32, ascent: *f32, descent: *f32, lineGap: *f32);

//--------------------------------------------------------------------------------------------
// Packing API: rasterizes ranges of glyphs into a single-channel atlas bitmap
//--------------------------------------------------------------------------------------------

@foreign public const STBTT_POINT_SIZE: i32;

// Returns 0 on failure. Pass null for allocContext to use malloc.
@foreign public func stbtt_PackBegin(spc: *stbtt_pack_context, pixels: *u8, width: i32, height: i32, strideInBytes: i32, padding: i32, allocContext: *void) : i32;
@foreign public func stbtt_PackEnd(spc: *stbtt_pack_context);
@foreign public func stbtt_PackSetOversampling(spc: *stbtt_pack_context, hOversample: u32, vOversample: u32);
@foreign public func stbtt_PackSetSkipMissingCodepoints(spc: *stbtt_pack_context, skip: i32);

// Returns 0 if any glyph didn't fit in the atlas.
@foreign public func stbtt_PackFontRange(spc: *stbtt_pack_context, fontdata: *const u8, fontIndex: i32, fontSize: f32,
                                        firstCodepoint: i32, numChars: i32, chardata: *stbtt_packedchar) : i32;
@foreign public func stbtt_PackFontRanges(spc: *stbtt_pack_context, fontdata: *const u8, fontIndex: i32, ranges: *stbtt_pack_range, numRanges: i32) : i32;

// Advances *xpos by the glyph's advance; alignToInteger snaps the quad to whole pixels.
@foreign public func stbtt_GetPackedQuad(chardata: *const stbtt_packedchar, pw: i32, ph: i32, charIndex: i32,
                                        xpos: *f32, ypos: *f32, q: *stbtt_aligned_quad, alignToInteger: i32);

//--------------------------------------------------------------------------------------------
// Single-glyph rasterization
//--------------------------------------------------------------------------------------------

// Returned bitmap must be released with stbtt_FreeBitmap.
@foreign public func stbtt_GetCodepointBitmap(info: *const stbtt_fontinfo, scaleX: f32, scaleY: f32, codepoint: i32,
                                             width: *i32, height: *i32, xoff: *i32, yoff: *i32) : *u8;
@foreign public func stbtt_FreeBitmap(bitmap: *u8, userdata: *void);
@foreign public func stbtt_MakeCodepointBitmap(info: *const stbtt_fontinfo, output: *u8, outW: i32, outH: i32, outStride: i32,
                                              scaleX: f32, scaleY: f32, codepoint: i32);
@foreign public func stbtt_GetCodepointBitmapBox(info: *const stbtt_fontinfo, codepoint: i32, scaleX: f32, scaleY: f32,
                                                ix0: *i32, iy0: *i32, ix1: *i32, iy1: *i32);
