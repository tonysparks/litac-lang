@foreign public func SDL_GetModState() : SDL_Keymod;
@foreign public func SDL_GetKeyName(key: SDL_Keycode) : *const char;
@foreign public func SDL_GetScancodeName(scancode: SDL_Scancode) : *const char;
@foreign public func SDL_GetKeyFromScancode(scancode: SDL_Scancode, modstate: SDL_Keymod, keyEvent: bool) : SDL_Keycode;
@foreign public func SDL_GetScancodeFromKey(key: SDL_Keycode, modstate: *SDL_Keymod) : SDL_Scancode;
@foreign public func SDL_StartTextInput(window: *SDL_Window) : bool;
@foreign public func SDL_StopTextInput(window: *SDL_Window) : bool;
@foreign public func SDL_TextInputActive(window: *SDL_Window) : bool;

