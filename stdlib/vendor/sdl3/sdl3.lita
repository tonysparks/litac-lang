@foreign public func SDL_FlushEvents(minType: u32, maxType: u32);

//--------------------------------------------------------------------------------------------
// Keyboard
//--------------------------------------------------------------------------------------------

// Indexed by SDL_Scancode; valid for the lifetime of the app, updated by SDL_PumpEvents/PollEvent.
