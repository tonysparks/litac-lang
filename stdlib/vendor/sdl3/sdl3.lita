@foreign public func SDL_GetGamepadAxis(gamepad: *SDL_Gamepad, axis: SDL_GamepadAxis) : i16;
@foreign public func SDL_GetGamepadButton(gamepad: *SDL_Gamepad, button: SDL_GamepadButton) : bool;
@foreign public func SDL_RumbleGamepad(gamepad: *SDL_Gamepad, lowFrequency: u16, highFrequency: u16, durationMS: u32) : bool;

//--------------------------------------------------------------------------------------------
// Timing
//--------------------------------------------------------------------------------------------

@foreign public func SDL_GetTicks() : u64;
@foreign public func SDL_GetTicksNS() : u64;
@foreign public func SDL_GetPerformanceCounter() : u64;
@foreign public func SDL_GetPerformanceFrequency() : u64;
@foreign public func SDL_Delay(ms: u32);
@foreign public func SDL_DelayNS(ns: u64);

//--------------------------------------------------------------------------------------------
// Audio
//--------------------------------------------------------------------------------------------

@foreign public const SDL_AUDIO_U8: SDL_AudioFormat;
@foreign public const SDL_AUDIO_S8: SDL_AudioFormat;
@foreign public const SDL_AUDIO_S16: SDL_AudioFormat;
@foreign public const SDL_AUDIO_S32: SDL_AudioFormat;
@foreign public const SDL_AUDIO_F32: SDL_AudioFormat;

@foreign public const SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK: SDL_AudioDeviceID;
@foreign public const SDL_AUDIO_DEVICE_DEFAULT_RECORDING: SDL_AudioDeviceID;

@foreign public func SDL_OpenAudioDevice(devid: SDL_AudioDeviceID, spec: *const SDL_AudioSpec) : SDL_AudioDeviceID;
@foreign public func SDL_CloseAudioDevice(devid: SDL_AudioDeviceID);
@foreign public func SDL_PauseAudioDevice(devid: SDL_AudioDeviceID) : bool;
@foreign public func SDL_ResumeAudioDevice(devid: SDL_AudioDeviceID) : bool;
@foreign public func SDL_GetAudioDeviceFormat(devid: SDL_AudioDeviceID, spec: *SDL_AudioSpec, sampleFrames: *i32) : bool;

// Opens a device and a bound stream in one call; the device starts paused (see SDL_ResumeAudioStreamDevice).
@foreign public func SDL_OpenAudioDeviceStream(devid: SDL_AudioDeviceID, spec: *const SDL_AudioSpec, callback: SDL_AudioStreamCallback, userdata: *void) : *SDL_AudioStream;
@foreign public func SDL_CreateAudioStream(srcSpec: *const SDL_AudioSpec, dstSpec: *const SDL_AudioSpec) : *SDL_AudioStream;
@foreign public func SDL_BindAudioStream(devid: SDL_AudioDeviceID, stream: *SDL_AudioStream) : bool;
@foreign public func SDL_UnbindAudioStream(stream: *SDL_AudioStream);
@foreign public func SDL_DestroyAudioStream(stream: *SDL_AudioStream);
@foreign public func SDL_GetAudioStreamDevice(stream: *SDL_AudioStream) : SDL_AudioDeviceID;
@foreign public func SDL_ResumeAudioStreamDevice(stream: *SDL_AudioStream) : bool;
@foreign public func SDL_PauseAudioStreamDevice(stream: *SDL_AudioStream) : bool;
@foreign public func SDL_PutAudioStreamData(stream: *SDL_AudioStream, buf: *const void, len: i32) : bool;
@foreign public func SDL_GetAudioStreamData(stream: *SDL_AudioStream, buf: *void, len: i32) : i32;
@foreign public func SDL_GetAudioStreamQueued(stream: *SDL_AudioStream) : i32;
@foreign public func SDL_GetAudioStreamAvailable(stream: *SDL_AudioStream) : i32;
@foreign public func SDL_FlushAudioStream(stream: *SDL_AudioStream) : bool;
@foreign public func SDL_ClearAudioStream(stream: *SDL_AudioStream) : bool;
@foreign public func SDL_SetAudioStreamGain(stream: *SDL_AudioStream, gain: f32) : bool;
@foreign public func SDL_SetAudioStreamFrequencyRatio(stream: *SDL_AudioStream, ratio: f32) : bool;

// audioBuf is allocated by SDL and must be released with SDL_free.
@foreign public func SDL_LoadWAV(path: *const char, spec: *SDL_AudioSpec, audioBuf: **u8, audioLen: *u32) : bool;
@foreign public func SDL_ConvertAudioSamples(srcSpec: *const SDL_AudioSpec, srcData: *const u8, srcLen: i32, dstSpec: *const SDL_AudioSpec, dstData: **u8, dstLen: *i32) : bool;
@foreign public func SDL_MixAudio(dst: *u8, src: *const u8, format: SDL_AudioFormat, len: u32, volume: f32) : bool;

