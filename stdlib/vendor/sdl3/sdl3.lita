// SDL3 bindings: the subset needed for a windowed OpenGL game -- init, windows, GL contexts,
// events, keyboard/mouse/gamepad input, timing and audio streams.
@include("<SDL3/SDL.h>");

@compiler_option(
    .os = "mac",
    .key = "sdl3",
    .default_path = "/opt/homebrew/opt/sdl3",
    .options = "-I{path}/include -L{path}/lib -lSDL3"
);

@compiler_option(
    .os = "linux",
    .options = "-lSDL3"
);

@compiler_option(
    .os = "windows",
    .key = "sdl3",
    .options = "-I{path}/include -L{path}/lib -lSDL3"
);

//--------------------------------------------------------------------------------------------
// Types
//--------------------------------------------------------------------------------------------

@foreign public typedef u32 as SDL_InitFlags;
@foreign public typedef u64 as SDL_WindowFlags;
@foreign public typedef u32 as SDL_WindowID;
@foreign public typedef u32 as SDL_KeyboardID;
@foreign public typedef u32 as SDL_MouseID;
@foreign public typedef u32 as SDL_JoystickID;
@foreign public typedef u32 as SDL_AudioDeviceID;
@foreign public typedef u32 as SDL_MouseButtonFlags;
@foreign public typedef u32 as SDL_MessageBoxFlags;
@foreign public typedef u32 as SDL_EventType;
@foreign public typedef u32 as SDL_Scancode;
@foreign public typedef u32 as SDL_Keycode;
@foreign public typedef u16 as SDL_Keymod;
@foreign public typedef u32 as SDL_MouseWheelDirection;
@foreign public typedef i32 as SDL_GLAttr;
@foreign public typedef u32 as SDL_GLProfile;
@foreign public typedef u32 as SDL_GLContextFlag;
@foreign public typedef u32 as SDL_AudioFormat;
@foreign public typedef i32 as SDL_GamepadAxis;
@foreign public typedef i32 as SDL_GamepadButton;

@foreign public struct SDL_Window {}
@foreign public typedef *void as SDL_GLContext;
@foreign public struct SDL_AudioStream {}
@foreign public struct SDL_Gamepad {}

@foreign public typedef func() : void as SDL_FunctionPointer;
@foreign public typedef func(*void, *SDL_AudioStream, i32, i32) : void as SDL_AudioStreamCallback;

@foreign public struct SDL_AudioSpec {
    format: SDL_AudioFormat
    channels: i32
    freq: i32
}

//--------------------------------------------------------------------------------------------
// Events -- only the commonly used members of SDL_Event are declared; the C union is authoritative.
//--------------------------------------------------------------------------------------------

@foreign public struct SDL_CommonEvent {
    type: u32
    reserved: u32
    timestamp: u64
}

@foreign public struct SDL_WindowEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    windowID: SDL_WindowID
    data1: i32
    data2: i32
}

@foreign public struct SDL_KeyboardEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    windowID: SDL_WindowID
    which: SDL_KeyboardID
    scancode: SDL_Scancode
    key: SDL_Keycode
    mod: SDL_Keymod
    raw: u16
    down: bool
    repeat: bool
}

@foreign public struct SDL_TextInputEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    windowID: SDL_WindowID
    text: *const char
}

@foreign public struct SDL_MouseMotionEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    windowID: SDL_WindowID
    which: SDL_MouseID
    state: SDL_MouseButtonFlags
    x: f32
    y: f32
    xrel: f32
    yrel: f32
}

@foreign public struct SDL_MouseButtonEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    windowID: SDL_WindowID
    which: SDL_MouseID
    button: u8
    down: bool
    clicks: u8
    padding: u8
    x: f32
    y: f32
}

@foreign public struct SDL_MouseWheelEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    windowID: SDL_WindowID
    which: SDL_MouseID
    x: f32
    y: f32
    direction: SDL_MouseWheelDirection
    mouse_x: f32
    mouse_y: f32
    integer_x: i32
    integer_y: i32
}

@foreign public struct SDL_GamepadDeviceEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    which: SDL_JoystickID
}

@foreign public struct SDL_GamepadAxisEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    which: SDL_JoystickID
    axis: u8
    padding1: u8
    padding2: u8
    padding3: u8
    value: i16
    padding4: u16
}

@foreign public struct SDL_GamepadButtonEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
    which: SDL_JoystickID
    button: u8
    down: bool
    padding1: u8
    padding2: u8
}

@foreign public struct SDL_QuitEvent {
    type: SDL_EventType
    reserved: u32
    timestamp: u64
}

@foreign public union SDL_Event {
    type: u32
    common: SDL_CommonEvent
    window: SDL_WindowEvent
    key: SDL_KeyboardEvent
    text: SDL_TextInputEvent
    motion: SDL_MouseMotionEvent
    button: SDL_MouseButtonEvent
    wheel: SDL_MouseWheelEvent
    gdevice: SDL_GamepadDeviceEvent
    gaxis: SDL_GamepadAxisEvent
    gbutton: SDL_GamepadButtonEvent
    quit: SDL_QuitEvent
    padding: [128]u8
}

