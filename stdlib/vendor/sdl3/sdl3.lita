@foreign public func SDL_ShowWindow(window: *SDL_Window) : bool;
@foreign public func SDL_HideWindow(window: *SDL_Window) : bool;
@foreign public func SDL_RaiseWindow(window: *SDL_Window) : bool;

// Ratio of pixels to window coordinates (2.0 on a Retina display).
@foreign public func SDL_GetWindowPixelDensity(window: *SDL_Window) : f32;
@foreign public func SDL_GetWindowDisplayScale(window: *SDL_Window) : f32;

