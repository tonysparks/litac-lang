// Relative mode hides the cursor and reports unbounded raw deltas -- what mouse-look wants.
@foreign public func SDL_SetWindowRelativeMouseMode(window: *SDL_Window, enabled: bool) : bool;
@foreign public func SDL_GetWindowRelativeMouseMode(window: *SDL_Window) : bool;
@foreign public func SDL_SetWindowMouseGrab(window: *SDL_Window, grabbed: bool) : bool;
@foreign public func SDL_GetMouseState(x: *f32, y: *f32) : SDL_MouseButtonFlags;
@foreign public func SDL_GetRelativeMouseState(x: *f32, y: *f32) : SDL_MouseButtonFlags;
@foreign public func SDL_WarpMouseInWindow(window: *SDL_Window, x: f32, y: f32);
@foreign public func SDL_ShowCursor() : bool;
@foreign public func SDL_HideCursor() : bool;

//--------------------------------------------------------------------------------------------
// Gamepad
//--------------------------------------------------------------------------------------------

// Returned array must be released with SDL_free.
@foreign public func SDL_GetGamepads(count: *i32) : *SDL_JoystickID;
