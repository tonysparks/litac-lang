@foreign public const SDL_WINDOWPOS_CENTERED: i32;
@foreign public const SDL_WINDOWPOS_UNDEFINED: i32;

@foreign public func SDL_CreateWindow(title: *const char, w: i32, h: i32, flags: SDL_WindowFlags) : *SDL_Window;
@foreign public func SDL_DestroyWindow(window: *SDL_Window);
@foreign public func SDL_GetWindowID(window: *SDL_Window) : SDL_WindowID;
