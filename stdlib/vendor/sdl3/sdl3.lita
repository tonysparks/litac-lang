@foreign public func SDL_QuitSubSystem(flags: SDL_InitFlags);
@foreign public func SDL_Quit();

@foreign public func SDL_GetError() : *const char;
@foreign public func SDL_ClearError() : bool;
@foreign public func SDL_GetVersion() : i32;
@foreign public func SDL_SetHint(name: *const char, value: *const char) : bool;
@foreign public func SDL_free(mem: *void);

// Directory of the running executable (with trailing separator); owned by SDL, do not free.
@foreign public func SDL_GetBasePath() : *const char;

@foreign public const SDL_MESSAGEBOX_ERROR: SDL_MessageBoxFlags;
@foreign public const SDL_MESSAGEBOX_WARNING: SDL_MessageBoxFlags;
@foreign public const SDL_MESSAGEBOX_INFORMATION: SDL_MessageBoxFlags;
@foreign public func SDL_ShowSimpleMessageBox(flags: SDL_MessageBoxFlags, title: *const char, message: *const char, window: *SDL_Window) : bool;

