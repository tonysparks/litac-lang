import "std/mem"
import "std/mem/linear_allocator"
import "std/string"
import "std/string/builder"
import "std/array"
import "std/json"
import "std/http/http"
import "std/map"
import "std/libc"
import "std/net/posix_socket"
import "std/system"
import "std/log"
import "std/io"
import "std/email/resend"
import "std/encoding/hex"

/**
=========================================================
// LogWatcher — tails a LogFormat.JSON log file and dispatches matching
// records to notification sinks (Slack, or anything else satisfying
// NotifySink).
=========================================================

Deliberately decoupled from std/log itself beyond the wire format: this
module never imports LogLevel/LogAttr, it only understands the JSON shape
Logv() with LogFormat.JSON produces
({"level":...,"time":...,"msg":...,"attrs":{...}}). That keeps it usable
against any process emitting that shape, not just one linked against this
exact build of std/log.

Intended to run as its own process, separate from the process doing the
logging — see the design notes this package grew out of: a tailer
survives the logged process crashing, an in-process hook does not.
LogWatcher.pollOnce() does one read-and-dispatch pass and returns; how
often that happens is left to the caller (a systemd timer invoking a
one-shot binary is the common case, not an in-process loop).
*/

public struct NotifyAttr {
    name:  String
    value: String
}

public struct NotifyEvent {
    level: String
    time:  String
    msg:   String
    attrs: Array<NotifyAttr>
}

public func (this: *NotifyEvent) getAttr(name: String) : String {
    for(var i = 0; i < this.attrs.length; i += 1) {
        var a = this.attrs.getPtr(i)
        if(a.name.equals(name)) {
            return a.value
        }
    }
    return $""
}

// ---------------------------------------------------------------
// Sink — anything that can receive a NotifyEvent. Slack is the first
// implementation (below); a future sink (email, PagerDuty, a generic
// webhook) just needs a matching send() method, nothing here changes.
// ---------------------------------------------------------------

public trait NotifySink {
    send: func(event: *NotifyEvent): bool
}

// ---------------------------------------------------------------
// Router — level/attr match rules, each paired with a sink
// ---------------------------------------------------------------

public struct NotifyRule {
    // Empty means "match any level".
    level: String
    // Empty means "don't filter on the event attr". Non-empty matches
    // against event.getAttr("event").
    event: String
    sink:  NotifySink
}

public struct NotifyRouter {
    rules: Array<NotifyRule>
}

public func (this: *NotifyRouter) init(allocator: *const Allocator) {
    this.rules.init(8, allocator)
}

public func (this: *NotifyRouter) addRule(level: String, event: String, sink: NotifySink) {
    this.rules.add(NotifyRule {
        .level = level,
        .event = event,
        .sink  = sink
    })
}

public func (this: *NotifyRouter) dispatch(event: *NotifyEvent) {
    for(var i = 0; i < this.rules.length; i += 1) {
        var rule = this.rules.getPtr(i)
        if(!rule.level.empty() && !rule.level.equals(event.level)) {
            continue
        }
        if(!rule.event.empty() && !rule.event.equals(event.getAttr($"event"))) {
            continue
        }
        rule.sink.send(event)
    }
}

// ---------------------------------------------------------------
// JSON line -> NotifyEvent
// ---------------------------------------------------------------

// Parses one JSON log record. Returned NotifyEvent's strings are views
// into memory owned by `allocator` (the parsed JsonNode tree) — the
// caller must not use the event past that allocator being cleared/freed.
func parseLogLine(line: String, allocator: *const Allocator) : *NotifyEvent {
    var parser = JsonParserInit(allocator)
    var root = parser.parseJson(line)
    if(parser.hasError() || !root || !root.isObject()) {
        return null
    }

    var event = new<NotifyEvent>(allocator)
    event.level = StringInit(root.getStr("level", ""))
    event.time  = StringInit(root.getStr("time", ""))
    event.msg   = StringInit(root.getStr("msg", ""))
    event.attrs.init(4, allocator)

    var attrsNode = root.getObject("attrs")
    if(attrsNode) {
        var it = attrsNode.iter()
        while(it.hasNext()) {
            var entry = it.next()
            event.attrs.add(NotifyAttr {
                .name  = StringInit(entry.key),
                .value = StringInit(entry.value.asString())
            })
        }
    }

    return event
}

// ---------------------------------------------------------------
// FileTailer — follows a file from a persisted byte offset, one poll
// at a time. Poll-based rather than inotify/kqueue: simple, portable
// across the dev (macOS) / prod (Linux) split, and notification latency
// of a second or two is fine for this use case.
// ---------------------------------------------------------------

const POLL_READ_CHUNK = 8192

// Bytes captured from the start of the tailed file and persisted alongside
// the offset, purely as an identity check — not a security hash, just
// "does this still look like the same file generation." See loadOffset().
// Long enough to reach past LogFormat.JSON's near-universal
// {"level":"...","time":"...} boilerplate into content that actually
// varies line to line (msg/attrs) — a short fingerprint risks matching
// two genuinely different file generations that just happen to share the
// same structural prefix.
const FINGERPRINT_LEN = 64
const STATE_BUF_SIZE = 192 // i64 digits/sign + ':' + hex fingerprint (128 chars) + slack

struct FileTailer {
    path:            String
    offsetStatePath: String
    offset:          i64
    pending:         StringBuilder // accumulates a line fread() split mid-record
}

func (this: *FileTailer) init(path: String, offsetStatePath: String, allocator: *const Allocator) {
    this.path = path
    this.offsetStatePath = offsetStatePath
    this.pending = StringBuilderInit(POLL_READ_CHUNK, allocator)
    this.offset = this.loadOffset()

    // poll() only persists the offset when it finds new bytes to read.
    // Under a one-shot invocation model (a fresh process per tick, e.g.
    // a systemd timer instead of an in-process loop), a run that finds
    // nothing new would otherwise exit without ever writing a state
    // file — so the *next* invocation's loadOffset() would hit the same
    // "no state file" fallback and recompute currentFileSize() against
    // whatever the file has grown to by then, silently treating
    // everything written in between as pre-existing history and
    // skipping it. Persisting the baseline immediately, whether it came
    // from an existing state file or the first-run fallback, closes
    // that gap: every invocation after the very first one always has a
    // real prior offset to resume from.
    this.saveOffset()
}

func (this: *FileTailer) currentFileSize() : i64 {
    var pathBuf: [MAX_PATH]char
    this.path.copyTo(pathBuf, MAX_PATH)

    var len = FileLength(pathBuf)
    return len < 0 ? 0_i64 : len
}

// Reads up to FINGERPRINT_LEN bytes from the *start* of the tailed file
// (independent of the current read offset) — an identity snapshot, not
// tailed content.
func (this: *FileTailer) readFingerprint(out: *u8) : i32 {
    var pathBuf: [MAX_PATH]char
    this.path.copyTo(pathBuf, MAX_PATH)

    var f = fopen(pathBuf, "rb")
    if(!f) {
        return 0
    }
    defer fclose(f)

    return fread(out, 1, FINGERPRINT_LEN as (usize), f) as (i32)
}

func (this: *FileTailer) loadOffset() : i64 {
    var stateBuf: [MAX_PATH]char
    this.offsetStatePath.copyTo(stateBuf, MAX_PATH)

    var f = fopen(stateBuf, "rb")
    if(!f) {
        // First run (no persisted offset yet): skip whatever history is
        // already in the file rather than replaying it all as "new".
        return this.currentFileSize()
    }
    defer fclose(f)

    var buf: [STATE_BUF_SIZE]char
    var n = fread(buf, 1, STATE_BUF_SIZE - 1, f)
    buf[n] = 0

    var content = StringInit(buf, n as (i32))
    var sepIdx = content.indexOf($":")
    var size = this.currentFileSize()

    if(sepIdx < 0) {
        // No fingerprint present — stale pre-fingerprint format, or the
        // file's simply corrupted. Either way there's nothing to verify
        // identity against, so don't trust a bare number either.
        Error("FileTailer: persisted state in '%.*s' has no fingerprint (stale format or corrupted) — resetting to current end of file\n",
            this.offsetStatePath.length, this.offsetStatePath.buffer
        )
        return size
    }

    var offsetBuf: [32]char
    content.substring(0, sepIdx).copyTo(offsetBuf, 32)
    var parsed = strtol(offsetBuf, null, 10)
    var hexPrint = content.substring(sepIdx + 1)

    // A negative value (corrupted state, torn write, strtol clamping an
    // unparseable string) or one beyond the file's current size (the file
    // is now smaller than where we left off — almost certainly truncated
    // by a rotation) can't be resumed from meaningfully. Start over from
    // whatever's here now rather than risk misreading stale content, or
    // replaying the whole file forever via a silently-failing fseek.
    if(parsed < 0 || parsed > size) {
        Error("FileTailer: persisted offset %lld in '%.*s' is invalid for current file size %lld — treating as rotated, resuming from byte 0\n",
            parsed, this.offsetStatePath.length, this.offsetStatePath.buffer, size
        )
        return 0
    }

    // The offset alone being in-bounds doesn't prove it still points at
    // the same content: a copytruncate-style rotation keeps the same
    // inode and can shrink-then-regrow past the old offset entirely
    // between two polls, leaving a numerically "valid" offset that
    // actually points at unrelated bytes from a different file
    // generation. Verify the file still starts the way it did when this
    // offset was saved before trusting it.
    var currentPrint: [FINGERPRINT_LEN]u8
    var currentPrintLen = this.readFingerprint(currentPrint)
    var expectedLen = hexPrint.length / 2

    var decodedPrint: [FINGERPRINT_LEN]u8
    var decodeOk = expectedLen <= FINGERPRINT_LEN && HexDecode(hexPrint, decodedPrint)

    // Compare only the overlap, not exact lengths: ordinary growth (more
    // content appended since the fingerprint was saved) makes the current
    // fingerprint region longer than what was persisted without anything
    // having rotated — that's expected and fine, not a mismatch. A
    // *shorter* current region than what was persisted, on the other
    // hand, is never legitimate: the file's own start can't shrink from
    // ordinary appends, so that alone means it was truncated.
    var overlap = expectedLen
    if(currentPrintLen < overlap) {
        overlap = currentPrintLen
    }

    if(!decodeOk || currentPrintLen < expectedLen || memcmp(currentPrint, decodedPrint, overlap as (usize)) != 0) {
        Error("FileTailer: '%.*s' no longer starts the way it did when offset %lld was saved — treating as rotated, resuming from byte 0\n",
            this.path.length, this.path.buffer, parsed
        )
        return 0
    }

    return parsed
}

func (this: *FileTailer) saveOffset() {
    var stateBuf: [MAX_PATH]char
    this.offsetStatePath.copyTo(stateBuf, MAX_PATH)

    var f = fopen(stateBuf, "wb")
    if(!f) {
        // A silent failure here means the offset never advances: the next
        // poll starts from the same stale position and redispatches
        // whatever it already sent, forever, with nothing in the logs to
        // explain why. Always surface it.
        Error("FileTailer: failed to persist offset to '%.*s': %s\n",
            this.offsetStatePath.length, this.offsetStatePath.buffer,
            strerror(errno)
        )
        return;
    }
    defer fclose(f)

    var fingerprint: [FINGERPRINT_LEN]u8
    var fingerprintLen = this.readFingerprint(fingerprint)

    var hexBuf: [FINGERPRINT_LEN * 2]char
    HexEncode(fingerprint, fingerprintLen, hexBuf)

    var buf: [STATE_BUF_SIZE]char
    var n = snprintf(buf, STATE_BUF_SIZE, "%lld:%.*s", this.offset, fingerprintLen * 2, hexBuf)
    fwrite(buf, 1, n as (usize), f)
}

// Reads whatever's new since the last poll, dispatches each complete
// line, and persists the new offset — but only past lines actually
// dispatched, so a record split across two polls is never half-processed.
func (this: *FileTailer) poll(linearAllocator: *LinearAllocator, router: *NotifyRouter) {
    var pathBuf: [MAX_PATH]char
    this.path.copyTo(pathBuf, MAX_PATH)

    var f = fopen(pathBuf, "rb")
    if(!f) {
        return; // not there yet (or rotated out from under us) — retry next tick
    }
    defer fclose(f)

    // An unchecked failure here silently leaves the read position wherever
    // fopen left it (byte 0) instead of this.offset, which reprocesses and
    // redispatches the entire file on this and every subsequent tick. Bail
    // out for this tick rather than read from the wrong place — offset
    // isn't touched, so the next tick retries from the same, still-correct,
    // starting point.
    if(fseek(f, this.offset, SEEK_SET) != 0) {
        Error("FileTailer: fseek to offset %lld in '%.*s' failed: %s\n",
            this.offset, this.path.length, this.path.buffer, strerror(errno)
        )
        return;
    }

    var buf: [POLL_READ_CHUNK]char
    var advanced = false

    while(true) {
        var n = fread(buf, 1, POLL_READ_CHUNK, f)
        if(n <= 0) {
            break
        }
        this.pending.append("%.*s", n as (i32), buf)
        advanced = true
    }

    if(!advanced) {
        return;
    }

    // Extract every complete "...\n" line; whatever's left after the last
    // newline stays in this.pending for the next poll to complete.
    var content = StringInit(this.pending.buffer, this.pending.length)
    var consumed = 0

    while(true) {
        var nlIdx = content.substring(consumed).indexOf($"\n")
        if(nlIdx < 0) {
            break
        }

        var lineEnd = consumed + nlIdx
        var line = content.substring(consumed, lineEnd)
        consumed = lineEnd + 1

        if(!line.empty()) {
            var event = parseLogLine(line, &linearAllocator.allocator)
            if(event) {
                router.dispatch(event)
            }
            linearAllocator.clear()
        }
    }

    // Keep only the unconsumed tail for next time.
    var remainder = content.substring(consumed)
    var remainderCopy = StringBuilderInit(remainder.length + 1, this.pending.alloc)
    remainderCopy.append("%.*s", remainder.length, remainder.buffer)
    this.pending.free()
    this.pending = remainderCopy

    this.offset += consumed
    this.saveOffset()
}

// ---------------------------------------------------------------
// LogWatcher — ties a FileTailer to a NotifyRouter and runs the poll loop
// ---------------------------------------------------------------

const LINE_ARENA_SIZE = 64 * 1024

public struct LogWatcher {
    tailer: FileTailer
    router: NotifyRouter
    linearAllocator: LinearAllocator
}

// logPath: the LogFormat.JSON file to tail.
// offsetStatePath: where the last-processed byte offset is persisted, so
// a restart resumes instead of either replaying history or losing lines
// written while this process was down.
public func (this: *LogWatcher) init(
    logPath: String,
    offsetStatePath: String,
    allocator: *const Allocator
) {
    this.tailer.init(logPath, offsetStatePath, allocator)
    this.router.init(allocator)

    var lineMem = allocator.alloc(LINE_ARENA_SIZE as (usize))
    this.linearAllocator.init(lineMem, LINE_ARENA_SIZE as (usize))
}

public func (this: *LogWatcher) addRule(level: String, event: String, sink: NotifySink) {
    this.router.addRule(level, event, sink)
}

// One read-and-dispatch pass over whatever's new since the last call.
// Scheduling (how often, and whether this process stays resident between
// calls) is entirely up to the caller — a one-shot binary invoked by a
// systemd timer just calls this once and exits.
//
// Each parsed record is processed inside a per-line arena that's cleared
// right after dispatch — mirrors the ringhttp per-request allocator
// pattern rather than routing per-record allocations through
// defaultAllocator, so a busy log file can't leak.
public func (this: *LogWatcher) pollOnce() {
    this.tailer.poll(&this.linearAllocator, &this.router)
}

// ---------------------------------------------------------------
// SlackWebhookSink — first concrete NotifySink implementation
// ---------------------------------------------------------------

const MAX_WEBHOOK_URL = 512

public struct SlackWebhookSink {
    webhookUrl: [MAX_WEBHOOK_URL]char
    http:       *Http
    allocator:  *const Allocator
}

// http is caller-owned: the caller configures and .init()/.free()s it, so
// multiple sinks pointed at the same destination (e.g. several
// SlackWebhookSinks in the same process, all talking to the same Slack
// workspace) can share one Http/curl handle instead of each owning its
// own — and the caller controls HttpOptions (timeouts, proxy, TLS
// verification) instead of being stuck with a hardcoded default.
public func (this: *SlackWebhookSink) init(webhookUrl: String, http: *Http, allocator: *const Allocator) {
    webhookUrl.copyTo(this.webhookUrl, MAX_WEBHOOK_URL)
    this.http = http
    this.allocator = allocator
}

public func (this: *SlackWebhookSink) send(event: *NotifyEvent) : bool {
    var text = StringBuilderInit(1024, this.allocator)
    defer text.free()

    text.append("*[%.*s]* %.*s\n%.*s",
        event.level.length, event.level.buffer,
        event.time.length, event.time.buffer,
        event.msg.length, event.msg.buffer
    )

    if(event.attrs.length > 0) {
        text.append("\n_")
        for(var i = 0; i < event.attrs.length; i += 1) {
            var a = event.attrs.getPtr(i)
            if(i > 0) {
                text.append(", ")
            }
            text.append("%.*s=%.*s", a.name.length, a.name.buffer, a.value.length, a.value.buffer)
        }
        text.append("_")
    }

    var payload = StringBuilderInit(text.length + 32, this.allocator)
    defer payload.free()
    payload.append("{\"text\":\"")
    JsonEscapeString(&payload.asBuffer, text.buffer, text.length)
    payload.append("\"}")

    var reqHeaders = HeadersInit(4, this.allocator)
    defer reqHeaders.free()
    reqHeaders.put($"Content-Type", $"application/json")

    // Built in place, not assigned from separate locals: resp.body/
    // resp.headers can get reallocated in place while curl writes the
    // response (growing the StringBuilder/Map backing arrays), so a
    // separate local copy freed independently afterward would free a
    // stale pointer out from under the live one — a double-free.
    var resp = HttpResponse {
        .body    = StringBuilderInit(256, this.allocator),
        .headers = HeadersInit(16, this.allocator),
    }
    defer resp.body.free()
    defer resp.headers.free()

    var url = this.webhookUrl as (*const char)
    var ok = this.http.post(url, &resp, StringInit(payload.buffer, payload.length), &reqHeaders)
    if(!ok || resp.statusCode != 200) {
        Error("slack webhook post failed: status=%d body=%.*s\n",
            resp.statusCode, resp.body.length, resp.body.buffer)
        return false
    }
    return true
}

// ---------------------------------------------------------------
// EmailSink — second concrete NotifySink implementation, over the Resend
// transactional email API (std/email/resend) rather than raw SMTP: one
// HTTPS POST, no MIME/SMTP protocol handling on our end.
// ---------------------------------------------------------------

public struct EmailSink {
    resend:    ResendClient
    toAddrs:   Array<String>
    allocator: *const Allocator
}

// httpClient/toAddrs are caller-owned and must outlive this sink —
// mirrors how SlackWebhookSink's http is caller-owned; this struct only
// borrows them (see ResendClient.init's doc comment for why: sharing one
// Http/curl handle across sinks instead of each owning its own).
public func (this: *EmailSink) init(
    config:     ResendConfig,
    httpClient: *Http,
    toAddrs:    Array<String>,
    allocator:  *const Allocator
) {
    this.resend.init(config, httpClient)
    this.toAddrs = toAddrs
    this.allocator = allocator
}

public func (this: *EmailSink) send(event: *NotifyEvent) : bool {
    var subject = StringBuilderInit(128, this.allocator)
    defer subject.free()
    subject.append("[%.*s] %.*s", event.level.length, event.level.buffer, event.msg.length, event.msg.buffer)

    var body = StringBuilderInit(1024, this.allocator)
    defer body.free()
    body.append("[%.*s] %.*s\n\n%.*s",
        event.level.length, event.level.buffer,
        event.time.length, event.time.buffer,
        event.msg.length, event.msg.buffer
    )

    if(event.attrs.length > 0) {
        body.append("\n\nAttributes:\n")
        for(var i = 0; i < event.attrs.length; i += 1) {
            var a = event.attrs.getPtr(i)
            body.append("  %.*s=%.*s\n", a.name.length, a.name.buffer, a.value.length, a.value.buffer)
        }
    }

    var bodyStr = StringInit(body.buffer, body.length)
    var result = this.resend.sendEmail(
        this.toAddrs,
        StringInit(subject.buffer, subject.length),
        $"", // html — plain text only, no HTML alternative to offer
        bodyStr,
        this.allocator
    )

    if(result.status != ResendStatus.OK) {
        Error("email sink send failed: %.*s\n", result.message.length, result.message.buffer)
        return false
    }
    return true
}
