import "std/ssl/openssl"

public const SHA256_DIGEST_SIZE: i32 = 32

// Fixed-size backing storage for a SHA-256 digest, mirroring std/system's PathBuf.
// Also reused by std/crypto/hmac for HmacSha256's output — HMAC-SHA256 produces the
// same 32-byte size as a plain SHA-256 digest, so one buffer type covers both rather
// than duplicating an identical 32-byte struct under a second name. HMAC-SHA1 (20
// bytes) does not fit this and gets its own HmacSha1Buf in std/crypto/hmac instead.
public struct Sha256Buf {
    buffer: [SHA256_DIGEST_SIZE]u8
}

// Computes SHA-256(data) via OpenSSL's EVP digest API and writes the digest to out.
public func Sha256(data: *const u8, len: i32, out: *Sha256Buf) : bool {
    var ctx = EVP_MD_CTX_new()
    if(!ctx) {
        return false
    }
    defer EVP_MD_CTX_free(ctx)

    if(EVP_DigestInit_ex(ctx, EVP_sha256(), null) != 1) {
        return false
    }
    if(len > 0 && EVP_DigestUpdate(ctx, data as (*const void), len as (usize)) != 1) {
        return false
    }

    var outLen: u32 = 0
    if(EVP_DigestFinal_ex(ctx, out.buffer as (*u8), &outLen) != 1) {
        return false
    }
    return outLen == SHA256_DIGEST_SIZE as (u32)
}
