import "std/ssl/openssl"
import "std/libc"

// EC (P-256) key handling, ECDH, and ES256 (ECDSA-SHA256) signing — built
// for Web Push (RFC 8291/8292): VAPID JWT signing and the ECDH step of
// message encryption. Not a general-purpose EC library — P-256 only, and
// only the operations Web Push actually needs.
//
// Built on OpenSSL 3.0's modern EVP_PKEY/OSSL_PARAM API throughout — no
// legacy EC_KEY calls, so no -Wdeprecated-declarations noise.

public const EC_P256_PRIVATE_KEY_SIZE: i32 = 32
public const EC_P256_PUBLIC_KEY_SIZE:  i32 = 65 // uncompressed point: 0x04 || X(32) || Y(32)

// Raw r||s concatenation (32 bytes each) — the JWS "P1363" signature format
// ES256 requires, as opposed to OpenSSL's default DER SEQUENCE{r,s}.
public const ECDSA_P1363_SIGNATURE_SIZE: i32 = 64

public struct EcKeyPair {
    pkey: *EVP_PKEY
}

// Generates a fresh P-256 keypair (both private and public). Used both for
// one-time VAPID identity generation and for the per-message ephemeral
// keypair RFC 8291 encryption requires.
public func EcGenerateKeyPair(pair: *EcKeyPair) : bool {
    pair.pkey = EVP_PKEY_Q_keygen(null, null, "EC", "P-256")
    return pair.pkey != null
}

// Builds an EVP_PKEY from raw bytes via an OSSL_PARAM_BLD — the documented
// OpenSSL 3.0 way to import a keypair/pubkey without a legacy EC_KEY
// intermediate. privateKey may be null (see EcPublicKeyFromRaw) to import a
// public-only key.
func fromRaw(privateKey: *const u8, publicKey: *const u8, pair: *EcKeyPair) : bool {
    var bld = OSSL_PARAM_BLD_new()
    if(!bld) {
        return false
    }
    defer OSSL_PARAM_BLD_free(bld)

    var ok = OSSL_PARAM_BLD_push_utf8_string(bld, "group", "P-256", 0) == 1
    ok = ok && OSSL_PARAM_BLD_push_octet_string(bld, "pub", publicKey as (*const void), EC_P256_PUBLIC_KEY_SIZE as (usize)) == 1

    // OSSL_PARAM_BLD_push_BN keeps a reference to *priv rather than copying
    // it — priv must stay alive until OSSL_PARAM_BLD_to_param() below, not
    // freed right after the push (confirmed via a standalone repro: freeing
    // early silently zeroes the private key in the resulting param set).
    var priv: *BIGNUM = null
    if(ok && privateKey) {
        priv = BN_bin2bn(privateKey, EC_P256_PRIVATE_KEY_SIZE, null)
        ok = ok && priv != null
        ok = ok && OSSL_PARAM_BLD_push_BN(bld, "priv", priv) == 1
    }
    if(!ok) {
        if(priv) {
            BN_free(priv)
        }
        return false
    }

    var params = OSSL_PARAM_BLD_to_param(bld)
    if(priv) {
        BN_free(priv)
    }
    if(!params) {
        return false
    }
    defer OSSL_PARAM_free(params)

    var ctx = EVP_PKEY_CTX_new_from_name(null, "EC", null)
    if(!ctx) {
        return false
    }
    defer EVP_PKEY_CTX_free(ctx)

    if(EVP_PKEY_fromdata_init(ctx) != 1) {
        return false
    }

    var pkey: *EVP_PKEY = null
    var selection = privateKey ? EVP_PKEY_SELECT_KEYPAIR : EVP_PKEY_SELECT_PUBLIC_KEY
    if(EVP_PKEY_fromdata(ctx, &pkey, selection, params) != 1) {
        return false
    }

    pair.pkey = pkey
    return true
}

// Reconstructs a full keypair from its raw serialized form: a
// EC_P256_PRIVATE_KEY_SIZE-byte big-endian private scalar and the
// EC_P256_PUBLIC_KEY_SIZE-byte uncompressed public point. Used to load a
// persisted VAPID keypair (both halves stored separately in config) at
// startup, rather than recomputing the public point from the private
// scalar every time.
public func EcKeyPairFromRaw(privateKey: *const u8, publicKey: *const u8, pair: *EcKeyPair) : bool {
    return fromRaw(privateKey, publicKey, pair)
}

// Imports only a public key — e.g. a browser's subscription p256dh point.
// Not usable for signing (no private scalar); only as the peer side of
// EcdhDerive.
public func EcPublicKeyFromRaw(publicKey: *const u8, pair: *EcKeyPair) : bool {
    return fromRaw(null, publicKey, pair)
}

public func (this: *EcKeyPair) free() {
    if(this.pkey) {
        EVP_PKEY_free(this.pkey)
        this.pkey = null
    }
}

// Exports the public key as an EC_P256_PUBLIC_KEY_SIZE-byte uncompressed
// point (0x04 || X || Y). out must point to a buffer of at least that size.
public func (this: *EcKeyPair) exportPublicKey(out: *u8) : bool {
    var ptr: *u8 = null
    var n = EVP_PKEY_get1_encoded_public_key(this.pkey, &ptr)
    if(!ptr) {
        return false
    }
    defer CRYPTO_free(ptr as (*void), null, 0)

    if(n != EC_P256_PUBLIC_KEY_SIZE as (usize)) {
        return false
    }
    memcpy(out, ptr, n)
    return true
}

// Exports the private scalar as an EC_P256_PRIVATE_KEY_SIZE-byte big-endian
// value. out must point to a buffer of at least that size.
public func (this: *EcKeyPair) exportPrivateKey(out: *u8) : bool {
    var bn: *BIGNUM = null
    if(EVP_PKEY_get_bn_param(this.pkey, "priv", &bn) != 1 || !bn) {
        return false
    }
    defer BN_free(bn)
    return BN_bn2binpad(bn, out, EC_P256_PRIVATE_KEY_SIZE) == EC_P256_PRIVATE_KEY_SIZE
}

// ECDH: derives the shared secret between a local (private) keypair and a
// peer's public key. out must point to a buffer of at least
// EC_P256_PRIVATE_KEY_SIZE bytes (P-256's shared secret is 32 bytes, the
// curve's field size — same constant, different meaning).
public func EcdhDerive(localPair: *EcKeyPair, peerPublic: *EcKeyPair, out: *u8) : bool {
    var ctx = EVP_PKEY_CTX_new(localPair.pkey, null)
    if(!ctx) {
        return false
    }
    defer EVP_PKEY_CTX_free(ctx)

    if(EVP_PKEY_derive_init(ctx) != 1) {
        return false
    }
    if(EVP_PKEY_derive_set_peer(ctx, peerPublic.pkey) != 1) {
        return false
    }

    var len = EC_P256_PRIVATE_KEY_SIZE as (usize)
    if(EVP_PKEY_derive(ctx, out, &len) != 1) {
        return false
    }
    return len == EC_P256_PRIVATE_KEY_SIZE as (usize)
}

// Max size of a DER-encoded ECDSA-Sig-Value for P-256 — each of r/s is at
// most 33 bytes (leading zero for sign-bit padding) plus ASN.1 SEQUENCE/
// INTEGER framing overhead; comfortably under 128.
const MAX_DER_SIGNATURE_SIZE = 128

// ES256 (ECDSA-SHA256) signing, producing the raw r||s concatenation JWS
// requires — not OpenSSL's default DER SEQUENCE{r,s}. out must point to a
// buffer of at least ECDSA_P1363_SIGNATURE_SIZE bytes.
public func EcdsaSignP1363(pair: *EcKeyPair, data: *const u8, dataLen: i32, out: *u8) : bool {
    var mdctx = EVP_MD_CTX_new()
    if(!mdctx) {
        return false
    }
    defer EVP_MD_CTX_free(mdctx)

    if(EVP_DigestSignInit(mdctx, null, EVP_sha256(), null, pair.pkey) != 1) {
        return false
    }

    var derLen: usize = 0_usize
    if(EVP_DigestSign(mdctx, null, &derLen, data, dataLen as (usize)) != 1) {
        return false
    }
    if(derLen as (i32) > MAX_DER_SIGNATURE_SIZE) {
        return false
    }

    var derBuf: [MAX_DER_SIGNATURE_SIZE]u8
    if(EVP_DigestSign(mdctx, derBuf as (*u8), &derLen, data, dataLen as (usize)) != 1) {
        return false
    }

    var derPtr = derBuf as (*const u8)
    var sig = d2i_ECDSA_SIG(null, &derPtr, derLen as (i64))
    if(!sig) {
        return false
    }
    defer ECDSA_SIG_free(sig)

    var r: *const BIGNUM = null
    var s: *const BIGNUM = null
    ECDSA_SIG_get0(sig, &r, &s)

    if(BN_bn2binpad(r, out, 32) != 32) {
        return false
    }
    if(BN_bn2binpad(s, &out[32], 32) != 32) {
        return false
    }
    return true
}

// Verifies an ES256 signature in raw r||s (P1363) format, the inverse of
// EcdsaSignP1363. Round-trips back through DER internally since
// EVP_DigestVerify only accepts that form.
public func EcdsaVerifyP1363(pair: *EcKeyPair, data: *const u8, dataLen: i32, sig: *const u8) : bool {
    var r = BN_bin2bn(sig, 32, null)
    if(!r) {
        return false
    }
    var s = BN_bin2bn(&sig[32], 32, null)
    if(!s) {
        BN_free(r)
        return false
    }

    var ecdsaSig = ECDSA_SIG_new()
    if(!ecdsaSig) {
        BN_free(r)
        BN_free(s)
        return false
    }
    if(ECDSA_SIG_set0(ecdsaSig, r, s) != 1) {
        BN_free(r)
        BN_free(s)
        ECDSA_SIG_free(ecdsaSig)
        return false
    }
    // r/s ownership transferred to ecdsaSig on success — only it needs freeing now.
    defer ECDSA_SIG_free(ecdsaSig)

    var derBuf: [MAX_DER_SIGNATURE_SIZE]u8
    var derPtr = derBuf as (*u8)
    var derLen = i2d_ECDSA_SIG(ecdsaSig, &derPtr)
    if(derLen <= 0 || derLen > MAX_DER_SIGNATURE_SIZE) {
        return false
    }

    var mdctx = EVP_MD_CTX_new()
    if(!mdctx) {
        return false
    }
    defer EVP_MD_CTX_free(mdctx)

    if(EVP_DigestVerifyInit(mdctx, null, EVP_sha256(), null, pair.pkey) != 1) {
        return false
    }

    return EVP_DigestVerify(mdctx, derBuf as (*const u8), derLen as (usize), data, dataLen as (usize)) == 1
}
