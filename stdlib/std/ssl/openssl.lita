// OpenSSL @foreign bindings for TLS, AEAD (AES-GCM), digest (SHA-256/SHA-1), and HMAC support.
//
// macOS: links against Homebrew OpenSSL 3 at /opt/homebrew/opt/openssl@3.
// Linux: links against the system libssl/libcrypto (-lssl -lcrypto).

@include("<openssl/ssl.h>");
@include("<openssl/err.h>");
@include("<openssl/evp.h>");
@include("<openssl/hmac.h>");
@include("<openssl/param_build.h>");

#if (OS == "MAC")
    @compiler_option(
        .os = "mac",
        .options = "-I/opt/homebrew/opt/openssl@3/include"
    );
    @compiler_option(
        .os = "mac",
        .options = "-L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto"
    );
#else
    @compiler_option(
        .os = "linux",
        .options = "-lssl -lcrypto"
    );
#end

// ---------------------------------------------------------------------------
// Opaque types
// ---------------------------------------------------------------------------

@foreign
public struct SSL_CTX {}

@foreign
public struct SSL {}

@foreign
public struct SSL_METHOD {}

// ---------------------------------------------------------------------------
// Constants — hardcoded because these are C preprocessor macros, not symbols.
// Values are stable across all OpenSSL/LibreSSL versions.
// ---------------------------------------------------------------------------

public const SSL_FILETYPE_PEM    = 1
public const SSL_ERROR_NONE      = 0
public const SSL_ERROR_SSL       = 1
public const SSL_ERROR_WANT_READ = 2
public const SSL_ERROR_WANT_WRITE= 3
public const SSL_ERROR_SYSCALL   = 5
public const SSL_ERROR_ZERO_RETURN = 6

// ALPN callback return codes (SSL_TLSEXT_ERR_*)
public const SSL_TLSEXT_ERR_OK    = 0
public const SSL_TLSEXT_ERR_NOACK = 3

// SSL_select_next_proto result codes
public const OPENSSL_NPN_NEGOTIATED = 1
public const OPENSSL_NPN_NO_OVERLAP = 0

// ---------------------------------------------------------------------------
// Context / method
// ---------------------------------------------------------------------------

@foreign
public func TLS_server_method() : *const SSL_METHOD;

@foreign
public func TLS_client_method() : *const SSL_METHOD;

@foreign
public func SSL_CTX_new(method: *const SSL_METHOD) : *SSL_CTX;

@foreign
public func SSL_CTX_free(ctx: *SSL_CTX);

@foreign
public func SSL_CTX_use_certificate_file(ctx: *SSL_CTX, file: *const char, type: i32) : i32;

@foreign
public func SSL_CTX_use_PrivateKey_file(ctx: *SSL_CTX, file: *const char, type: i32) : i32;

@foreign
public func SSL_CTX_check_private_key(ctx: *SSL_CTX) : i32;

// SSL_VERIFY_NONE: skip peer certificate verification (useful for test clients).
public const SSL_VERIFY_NONE: i32 = 0

// Set the verification mode for a context.  Pass null for the callback to use default.
public typedef func(*SSL, i32) : i32 as SslVerifyCallback;
@foreign
public func SSL_CTX_set_verify(ctx: *SSL_CTX, mode: i32, cb: SslVerifyCallback);

// Client-side ALPN: wire-format list (length-prefixed), e.g. "\x02h2\x08http/1.1".
// Returns 0 on success (note: inverted from most OpenSSL functions).
@foreign
public func SSL_CTX_set_alpn_protos(ctx: *SSL_CTX, protos: *const u8, protos_len: u32) : i32;

// ALPN — server-side selection callback.
// Signature: int cb(SSL*, const u8** out, u8* outlen, const u8* in, uint inlen, void* arg)
public typedef func(*SSL, **const u8, *u8, *const u8, u32, *void) : i32 as AlpnSelectCallback;

@foreign
public func SSL_CTX_set_alpn_select_cb(ctx: *SSL_CTX, cb: AlpnSelectCallback, arg: *void);

// Wire-format ALPN string helpers (length-prefixed protocol list).
@foreign
public func SSL_select_next_proto(
    out    : **u8,
    outlen : *u8,
    server : *const u8,
    server_len: u32,
    client : *const u8,
    client_len: u32
) : i32;


// ---------------------------------------------------------------------------
// Per-connection SSL object
// ---------------------------------------------------------------------------

@foreign
public func SSL_new(ctx: *SSL_CTX) : *SSL;

@foreign
public func SSL_free(ssl: *SSL);

@foreign
public func SSL_set_fd(ssl: *SSL, fd: i32) : i32;

@foreign
public func SSL_get_fd(ssl: *const SSL) : i32;

// SSL_accept: perform the TLS handshake as server.
// Returns 1 on success, <=0 on error/pending.
@foreign
public func SSL_accept(ssl: *SSL) : i32;

// SSL_connect: perform the TLS handshake as client.
// Returns 1 on success, <=0 on error/pending.
@foreign
public func SSL_connect(ssl: *SSL) : i32;

// SSL_shutdown: initiate a graceful TLS close_notify shutdown.
// Returns 1 when complete, 0 when the peer's close_notify is still pending.
@foreign
public func SSL_shutdown(ssl: *SSL) : i32;

// Returns one of the SSL_ERROR_* constants.
@foreign
public func SSL_get_error(ssl: *SSL, ret: i32) : i32;

// ---------------------------------------------------------------------------
// I/O
// ---------------------------------------------------------------------------

@foreign
public func SSL_read(ssl: *SSL, buf: *void, num: i32) : i32;

@foreign
public func SSL_write(ssl: *SSL, buf: *const void, num: i32) : i32;

// Returns bytes already decrypted and buffered inside OpenSSL (not yet read by the app).
// After SSL_accept/SSL_connect, the peer may have sent application data in the same TCP
// segment as the final handshake message; those bytes are buffered here, invisible to kqueue.
@foreign
public func SSL_pending(ssl: *const SSL) : i32;

// Returns 1 if ssl has ANY data buffered internally — either decrypted bytes ready
// to be read (SSL_pending > 0) OR undecrypted bytes in the SSL input buffer that
// have been read from the socket but not yet returned to the app.  Use this instead
// of SSL_pending when checking whether another SSL_read call is safe on a blocking fd:
// SSL_read will not block if SSL_has_pending returns 1.
@foreign
public func SSL_has_pending(ssl: *const SSL) : i32;

// ---------------------------------------------------------------------------
// ALPN result (after handshake)
// ---------------------------------------------------------------------------

// Writes a pointer + length for the negotiated protocol name (not NUL-terminated).
@foreign
public func SSL_get0_alpn_selected(ssl: *const SSL, data: **const u8, len: *u32);

// ---------------------------------------------------------------------------
// Memory BIO (for io_uring: keeps all I/O through io_uring READ/SENDMSG)
// ---------------------------------------------------------------------------

@foreign
public struct BIO {}

@foreign
public struct BIO_METHOD {}

// Returns the BIO_METHOD for in-memory (no-fd) BIOs.
@foreign
public func BIO_s_mem() : *BIO_METHOD;

// Create a new BIO of the given type.
@foreign
public func BIO_new(type: *BIO_METHOD) : *BIO;

// Free a BIO that has not been transferred to an SSL object.
@foreign
public func BIO_free(bio: *BIO);

// Transfer ownership of rbio/wbio to ssl. After this call, SSL_free frees them.
@foreign
public func SSL_set_bio(ssl: *SSL, rbio: *BIO, wbio: *BIO);

// Retrieve the read / write BIO from an SSL object (no ownership transfer).
@foreign
public func SSL_get_rbio(ssl: *const SSL) : *BIO;

@foreign
public func SSL_get_wbio(ssl: *const SSL) : *BIO;

// Write data into a BIO; returns bytes written or <=0 on error.
@foreign
public func BIO_write(bio: *BIO, data: *const void, len: i32) : i32;

// Read data out of a BIO; returns bytes read or <=0 when empty.
@foreign
public func BIO_read(bio: *BIO, data: *void, len: i32) : i32;

// BIO_ctrl command: query how many bytes are available to read.
// (Maps to the BIO_pending(b) macro which expands to BIO_ctrl(b,10,0,NULL).)
public const BIO_CTRL_PENDING: i32 = 10

@foreign
public func BIO_ctrl(bio: *BIO, cmd: i32, larg: i64, parg: *void) : i64;

// ---------------------------------------------------------------------------
// EVP symmetric cipher (AES-256-GCM and others)
// ---------------------------------------------------------------------------

@foreign
public struct EVP_CIPHER_CTX {}

@foreign
public struct EVP_CIPHER {}

@foreign
public func EVP_CIPHER_CTX_new() : *EVP_CIPHER_CTX;

@foreign
public func EVP_CIPHER_CTX_free(ctx: *EVP_CIPHER_CTX);

@foreign
public func EVP_aes_256_gcm() : *const EVP_CIPHER;

@foreign
public func EVP_aes_128_gcm() : *const EVP_CIPHER;

// Pass type=null on second call to reuse cipher without reinit.
// Pass key=null, iv=null on first call to set cipher before key/iv.
@foreign
public func EVP_EncryptInit_ex(ctx: *EVP_CIPHER_CTX, type_: *const EVP_CIPHER,
                                impl: *void, key: *const u8, iv: *const u8) : i32;

@foreign
public func EVP_EncryptUpdate(ctx: *EVP_CIPHER_CTX,
                               out: *u8, outl: *i32,
                               in_: *const u8, inl: i32) : i32;

@foreign
public func EVP_EncryptFinal_ex(ctx: *EVP_CIPHER_CTX, out: *u8, outl: *i32) : i32;

@foreign
public func EVP_DecryptInit_ex(ctx: *EVP_CIPHER_CTX, type_: *const EVP_CIPHER,
                                impl: *void, key: *const u8, iv: *const u8) : i32;

@foreign
public func EVP_DecryptUpdate(ctx: *EVP_CIPHER_CTX,
                               out: *u8, outl: *i32,
                               in_: *const u8, inl: i32) : i32;

// Returns <= 0 if GCM tag verification fails.
@foreign
public func EVP_DecryptFinal_ex(ctx: *EVP_CIPHER_CTX, out: *u8, outl: *i32) : i32;

// GCM control: set IV length, get/set authentication tag.
@foreign
public func EVP_CIPHER_CTX_ctrl(ctx: *EVP_CIPHER_CTX, type_: i32, arg: i32, ptr: *void) : i32;

// EVP_CTRL_GCM_* constants (OpenSSL preprocessor macros)
public const EVP_CTRL_GCM_SET_IVLEN: i32 = 0x9
public const EVP_CTRL_GCM_GET_TAG:   i32 = 0x10
public const EVP_CTRL_GCM_SET_TAG:   i32 = 0x11

// ---------------------------------------------------------------------------
// EVP message digest (SHA-256, SHA-1) and HMAC
// ---------------------------------------------------------------------------

@foreign
public struct EVP_MD {}

@foreign
public struct EVP_MD_CTX {}

@foreign
public func EVP_MD_CTX_new() : *EVP_MD_CTX;

@foreign
public func EVP_MD_CTX_free(ctx: *EVP_MD_CTX);

@foreign
public func EVP_sha1() : *const EVP_MD;

@foreign
public func EVP_sha256() : *const EVP_MD;

@foreign
public func EVP_DigestInit_ex(ctx: *EVP_MD_CTX, type_: *const EVP_MD, impl: *void) : i32;

@foreign
public func EVP_DigestUpdate(ctx: *EVP_MD_CTX, data: *const void, count: usize) : i32;

@foreign
public func EVP_DigestFinal_ex(ctx: *EVP_MD_CTX, md: *u8, size: *u32) : i32;

// One-shot HMAC. Returns md on success, null on failure.
@foreign
public func HMAC(evp_md: *const EVP_MD, key: *const void, key_len: i32,
                  d: *const u8, n: usize, md: *u8, md_len: *u32) : *u8;

// ---------------------------------------------------------------------------
// EC (P-256) keys, ECDH, ECDSA — used by std/crypto/ec (Web Push: VAPID
// signing, subscription-key ECDH). Built entirely on the modern OpenSSL 3.0
// EVP_PKEY/OSSL_PARAM API (no legacy EC_KEY calls) — keygen and pubkey
// export are one-liners (EVP_PKEY_Q_keygen, EVP_PKEY_get1_encoded_public_key);
// importing a keypair from raw bytes goes through an OSSL_PARAM_BLD, the
// documented way to build an EVP_PKEY from caller-supplied group/point/
// scalar values without a legacy EC_KEY as an intermediate.
// ---------------------------------------------------------------------------

@foreign
public struct EVP_PKEY {}

@foreign
public struct EVP_PKEY_CTX {}

@foreign
public struct BIGNUM {}

@foreign
public struct ECDSA_SIG {}

@foreign
public struct OSSL_PARAM_BLD {}

@foreign
public struct OSSL_PARAM {}

// NID_X9_62_prime256v1 — the P-256 curve. Stable across OpenSSL versions.
public const NID_X9_62_PRIME256V1: i32 = 415

// EVP_PKEY_fromdata() "selection" bitmasks. Computed from OpenSSL's
// OSSL_KEYMGMT_SELECT_* bits (core_dispatch.h) rather than binding those
// individually — this is the only place the combinations are needed.
public const EVP_PKEY_SELECT_PUBLIC_KEY: i32 = 0x86 // domain params | public key
public const EVP_PKEY_SELECT_KEYPAIR:    i32 = 0x87 // domain params | public key | private key

@foreign
public func EVP_PKEY_free(pkey: *EVP_PKEY);

// One-liner keygen: EVP_PKEY_Q_keygen(null, null, "EC", "P-256").
@foreign
public func EVP_PKEY_Q_keygen(libctx: *void, propq: *const char, type_: *const char, ...) : *EVP_PKEY;

// Exports the public point in uncompressed form (65 bytes for P-256).
// Allocates *ppub via OpenSSL's allocator — caller must OPENSSL_free it.
@foreign
public func EVP_PKEY_get1_encoded_public_key(pkey: *EVP_PKEY, ppub: **u8) : usize;

// Reads a BIGNUM-typed param — for EC keys, OSSL_PKEY_PARAM_PRIV_KEY = "priv"
// is this type (not an octet string). Caller owns *bn, must BN_free it.
@foreign
public func EVP_PKEY_get_bn_param(pkey: *const EVP_PKEY, key_name: *const char, bn: **BIGNUM) : i32;

@foreign
public func EVP_PKEY_CTX_new(pkey: *EVP_PKEY, e: *void) : *EVP_PKEY_CTX;

// type_ = "EC" for P-256 keypair/pubkey import via EVP_PKEY_fromdata.
@foreign
public func EVP_PKEY_CTX_new_from_name(libctx: *void, type_: *const char, propq: *const char) : *EVP_PKEY_CTX;

@foreign
public func EVP_PKEY_fromdata_init(ctx: *EVP_PKEY_CTX) : i32;

@foreign
public func EVP_PKEY_fromdata(ctx: *EVP_PKEY_CTX, ppkey: **EVP_PKEY, selection: i32, param: *OSSL_PARAM) : i32;

@foreign
public func OSSL_PARAM_BLD_new() : *OSSL_PARAM_BLD;

@foreign
public func OSSL_PARAM_BLD_free(bld: *OSSL_PARAM_BLD);

@foreign
public func OSSL_PARAM_BLD_to_param(bld: *OSSL_PARAM_BLD) : *OSSL_PARAM;

// key = "group" (curve name, e.g. "P-256").
@foreign
public func OSSL_PARAM_BLD_push_utf8_string(bld: *OSSL_PARAM_BLD, key: *const char, buf: *const char, bsize: usize) : i32;

// key = "pub" (uncompressed EC point).
@foreign
public func OSSL_PARAM_BLD_push_octet_string(bld: *OSSL_PARAM_BLD, key: *const char, buf: *const void, bsize: usize) : i32;

// key = "priv" (private scalar, as a BIGNUM).
@foreign
public func OSSL_PARAM_BLD_push_BN(bld: *OSSL_PARAM_BLD, key: *const char, bn: *const BIGNUM) : i32;

@foreign
public func OSSL_PARAM_free(param: *OSSL_PARAM);

// Frees buffers OpenSSL itself allocated (e.g. EVP_PKEY_get1_encoded_public_key's
// output). OPENSSL_free() is a macro around this (passing __FILE__/__LINE__ for
// its leak-tracking build); file/line are diagnostic-only, so passing null/0
// directly through CRYPTO_free is equivalent for our purposes.
@foreign
public func CRYPTO_free(ptr: *void, file: *const char, line: i32);

@foreign
public func EVP_PKEY_CTX_free(ctx: *EVP_PKEY_CTX);

// ECDH shared-secret derivation.
@foreign
public func EVP_PKEY_derive_init(ctx: *EVP_PKEY_CTX) : i32;

@foreign
public func EVP_PKEY_derive_set_peer(ctx: *EVP_PKEY_CTX, peer: *EVP_PKEY) : i32;

// Pass key=null to query the required buffer length into *keylen first.
@foreign
public func EVP_PKEY_derive(ctx: *EVP_PKEY_CTX, key: *u8, keylen: *usize) : i32;

// One-shot ECDSA signing (ES256 = this + EVP_sha256()). Produces a
// DER-encoded SEQUENCE{r,s} — see ECDSA_SIG_get0 below to convert to the
// raw r||s form JOSE/JWS actually requires.
@foreign
public func EVP_DigestSignInit(ctx: *EVP_MD_CTX, pctx: **EVP_PKEY_CTX,
                                type_: *const EVP_MD, e: *void, pkey: *EVP_PKEY) : i32;

// Pass sigret=null to query the required buffer length into *siglen first.
@foreign
public func EVP_DigestSign(ctx: *EVP_MD_CTX, sigret: *u8, siglen: *usize,
                            tbs: *const u8, tbslen: usize) : i32;

// BIGNUM — used to extract/inject fixed-width big-endian scalars (EC
// private keys, ECDSA r/s components).
@foreign
public func BN_bin2bn(s: *const u8, len: i32, ret: *BIGNUM) : *BIGNUM;

// Writes exactly tolen bytes, big-endian, zero-padded on the left.
@foreign
public func BN_bn2binpad(a: *const BIGNUM, to: *u8, tolen: i32) : i32;

@foreign
public func BN_free(a: *BIGNUM);

// Parses the DER SEQUENCE{r,s} that EVP_DigestSign produces, so r/s can be
// re-emitted as the fixed 32-byte-each raw concatenation JWS ES256 needs.
@foreign
public func d2i_ECDSA_SIG(sig: **ECDSA_SIG, pp: **const u8, len: i64) : *ECDSA_SIG;

@foreign
public func ECDSA_SIG_get0(sig: *const ECDSA_SIG, pr: **const BIGNUM, ps: **const BIGNUM);

@foreign
public func ECDSA_SIG_free(sig: *ECDSA_SIG);

@foreign
public func ECDSA_SIG_new() : *ECDSA_SIG;

// Takes ownership of r and s (do not BN_free them separately afterward).
@foreign
public func ECDSA_SIG_set0(sig: *ECDSA_SIG, r: *BIGNUM, s: *BIGNUM) : i32;

// Re-encodes an ECDSA_SIG back to DER — the inverse of d2i_ECDSA_SIG, used
// to verify a raw r||s (P1363-format) signature via EVP_DigestVerify, which
// only accepts the DER form.
@foreign
public func i2d_ECDSA_SIG(sig: *const ECDSA_SIG, pp: **u8) : i32;

@foreign
public func EVP_DigestVerifyInit(ctx: *EVP_MD_CTX, pctx: **EVP_PKEY_CTX,
                                  type_: *const EVP_MD, e: *void, pkey: *EVP_PKEY) : i32;

// Returns 1 if the signature is valid, 0 if invalid, <0 on error.
@foreign
public func EVP_DigestVerify(ctx: *EVP_MD_CTX, sigret: *const u8, siglen: usize,
                              tbs: *const u8, tbslen: usize) : i32;

